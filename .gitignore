# Project-wide gitignore

# Database files (exported from app)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Backup files
*~
*.swp
*.bak
*.tmp
*.orig

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
dist/
build/
# Temporary files and folders
tmp/
temp/
*.tmp
*.temp

# Android build outputs
outputs/

# Logs
*.log
# Sensitive/secret files
.env
.env.*
local.properties

# Sensitive data
secrets.xml
api-keys.properties
credentials.json
*.key
*.pem

# Additional Android/IDE artifacts and sensitive files
.gradle/
captures/
*.keystore
*.jks
*.properties
*.ipr
*.iws
*.cxx/
*.tmp
*.temp
*.apk
*.ap_
*.aab

# Android build intermediates and outputs
WIFIGEOGRABBER/app/build/
WIFIGEOGRABBER/build/
*.jks
*.keystore

# Ignore Python virtual environment
venv/
venv/*
