# === Project-wide gitignore ===

# --- Datenbanken ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Backups & temporäre Editor-Dateien ---
*~
*.swp
*.bak
*.tmp
*.orig
*.temp

# --- Betriebssystem ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
._*

# --- IDEs & Editoren ---
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.sublime-*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
pip-log.txt
pip-delete-this-directory.txt

# --- Python Virtual Environments ---
env/
venv/
ENV/
env*/
venv*/
.venv/

# --- Android Build & Artifacts ---
# Gradle
.gradle/
local.properties
captures/

# Build outputs
build/
*/build/
outputs/
*.apk
*.ap_
*.aab

# Keystores & Zertifikate
*.jks
*.keystore

# Android Studio / IntelliJ
.cxx/
*.hprof

# --- Logs ---
*.log
logs/
log/

# --- Secrets & Konfiguration ---
.env
.env.*
.env.local
.env.development
.env.production
secrets.xml
api-keys.properties
credentials.json
*.key
*.pem
*.crt
*.cer

# --- Sonstiges ---
tmp/
temp/
*.tmp
*.temp