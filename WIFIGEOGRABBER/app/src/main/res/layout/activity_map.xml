<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- WebView für die Karte -->
    <WebView
        android:id="@+id/map_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/button_layout"
        android:layout_below="@+id/db_status_text" />

    <!-- Status-Text für Datenbank -->
    <TextView
        android:id="@+id/db_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#AA000000"
        android:text="Interne Datenbank"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:padding="4dp"
        android:gravity="center" />

    <!-- Button-Layout am unteren Rand -->
    <LinearLayout
        android:id="@+id/button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:padding="8dp"
        android:gravity="center">

        <!-- Zurück Button -->
        <Button
            android:id="@+id/back_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="← Zurück"
            android:textColor="#FFFFFF"
            android:background="#FF4444"
            android:textSize="14sp" />

        <!-- Aktualisieren Button -->
        <Button
            android:id="@+id/refresh_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="🔄 Aktualisieren"
            android:textColor="#FFFFFF"
            android:background="#4488FF"
            android:textSize="14sp" />

        <!-- Live Location Button -->
        <Button
            android:id="@+id/location_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="📍 Standort"
            android:textColor="#FFFFFF"
            android:background="#4CAF50"
            android:textSize="14sp" />

    </LinearLayout>

</RelativeLayout>
