<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">


    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/status_stopped"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/networks_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/found_networks"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"/>

    <TextView
        android:id="@+id/info_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Active: 0 WiFi, 0 BT | Total: 0 WiFi, 0 BT"
        android:textSize="12sp"
        android:textColor="#666666"
        android:padding="4dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="4dp"/>

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <Button
            android:id="@+id/toggle_scan_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/wifi_start"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A0A2A"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/bluetooth_toggle_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/bt_off"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A0A2A"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/show_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/show_data"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A0A2A"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/more_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/more"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A0A2A"
            android:layout_margin="2dp"/>

    </LinearLayout>

    <!-- Second button row for map -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:baselineAligned="false">

        <Button
            android:id="@+id/map_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/show_map"
            android:textSize="12sp"
            android:backgroundTint="#0A0A2A"
            android:textColor="#FFFFFF"
            android:layout_margin="2dp"/>

        <!-- Placeholder for more buttons -->
        <View
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="3"
            android:layout_margin="2dp"/>

    </LinearLayout>

    <ListView
        android:id="@+id/data_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/debug_log"
        android:textStyle="bold"
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:backgroundTint="#E0E0E0"/>

    <ScrollView
        android:id="@+id/logcat_scrollview"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#000000"
        android:padding="4dp">

        <TextView
            android:id="@+id/logcat_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logcat_placeholder"
            android:textColor="#00FF00"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:padding="4dp"/>

    </ScrollView>

</LinearLayout>