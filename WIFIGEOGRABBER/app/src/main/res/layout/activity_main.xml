<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">


    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Status: Stopped"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/networks_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gefundene Netzwerke:"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"/>

    <TextView
        android:id="@+id/info_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aktiv: 0 WiFi, 0 BT | Gesamt: 0 WiFi, 0 BT"
        android:textSize="12sp"
        android:textColor="#666666"
        android:padding="4dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="4dp"/>

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <Button
            android:id="@+id/toggle_scan_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="WiFi Start"
            android:textSize="10sp"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/bluetooth_toggle_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="BT aus"
            android:textSize="10sp"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/show_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Show Data"
            android:textSize="10sp"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/more_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Mehr"
            android:textSize="10sp"
            android:layout_margin="2dp"/>

    </LinearLayout>

    <!-- Zweite Button-Zeile für Karte -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:baselineAligned="false">

        <Button
            android:id="@+id/map_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🗺️ Karte anzeigen"
            android:textSize="12sp"
            android:background="#FF6B35"
            android:textColor="#FFFFFF"
            android:layout_margin="2dp"/>

        <!-- Platzhalter für weitere Buttons -->
        <View
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="3"
            android:layout_margin="2dp"/>

    </LinearLayout>

    <ListView
        android:id="@+id/data_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Debug Log:"
        android:textStyle="bold"
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:background="#E0E0E0"/>

    <ScrollView
        android:id="@+id/logcat_scrollview"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#000000"
        android:padding="4dp">

        <TextView
            android:id="@+id/logcat_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LogCat wird hier angezeigt...\n"
            android:textColor="#00FF00"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:padding="4dp"/>

    </ScrollView>

</LinearLayout>